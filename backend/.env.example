PORT=5000
NODE_ENV=development

# Local Postgres (copy this file to .env and edit):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ishaka_market
#
# Render: use Internal URL on the web service, or External URL when seeding from your PC:
DATABASE_URL=paste_external_url_here
JWT_SECRET=replace_this_in_production
JWT_EXPIRES_IN=7d
# Optional: promote an account to admin via POST /auth/promote-admin (header X-Promote-Admin-Key). Min 16 characters; keep secret.
ADMIN_BOOTSTRAP_KEY=
FRONTEND_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
